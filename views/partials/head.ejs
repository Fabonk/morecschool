<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= seo.titre %></title>
    <% if (seo.description) { %><meta name="description" content="<%= seo.description %>"><% } %>
    <meta property="og:title" content="<%= seo.titre %>">
    <% if (seo.description) { %><meta property="og:description" content="<%= seo.description %>"><% } %>
    <meta property="og:type" content="website">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&family=Open+Sans:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>
<body class="<%= heroOverlay ? 'page-accueil' : 'page-interne' %>">
