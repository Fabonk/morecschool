    <div class="modal-overlay" id="modalInscription">
        <div class="modal">
            <button class="modal-close" id="closeInscription"><i class="fas fa-times"></i></button>
            <div class="modal-header">
                <span class="modal-icon"><i class="fas fa-calendar-check"></i></span>
                <h3>Inscription à l'Événement</h3>
            </div>
            <div class="modal-event-info" id="modalEventInfo">
                <p><strong id="modalEventName"></strong></p>
                <p><i class="fas fa-calendar-alt"></i> <span id="modalEventDate"></span> &bull; <i class="fas fa-map-marker-alt"></i> <span id="modalEventLieu"></span></p>
            </div>
            <form class="modal-form" id="formInscription">
                <div class="form-row">
                    <div class="form-group">
                        <label for="inscNom"><i class="fas fa-user"></i> Nom complet *</label>
                        <input type="text" id="inscNom" name="nom" required placeholder="Votre nom complet" />
                    </div>
                    <div class="form-group">
                        <label for="inscEmail"><i class="fas fa-envelope"></i> Email *</label>
                        <input type="email" id="inscEmail" name="email" required placeholder="votre@email.com" />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label for="inscTel"><i class="fas fa-phone"></i> Téléphone *</label>
                        <input type="tel" id="inscTel" name="telephone" required placeholder="+225 07 00 00 00 00" />
                    </div>
                    <div class="form-group">
                        <label for="inscOrg"><i class="fas fa-building"></i> Organisation</label>
                        <input type="text" id="inscOrg" name="organisation" placeholder="Votre entreprise (optionnel)" />
                    </div>
                </div>
                <button type="submit" class="btn btn-primary btn-block"><i class="fas fa-check-circle"></i> Confirmer l'Inscription</button>
            </form>
        </div>
    </div>
