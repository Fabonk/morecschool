    <div class="modal-overlay" id="modalEvaluation">
        <div class="modal modal-quiz">
            <button class="modal-close" id="closeEvaluation"><i class="fas fa-times"></i></button>
            <div class="modal-header">
                <span class="modal-icon quiz"><i class="fas fa-clipboard-check"></i></span>
                <h3>Évaluation : <span id="quizPlaylistName"></span></h3>
            </div>
            <div class="quiz-progress-bar">
                <div class="quiz-progress-fill" id="quizProgressFill"></div>
            </div>
            <p class="quiz-counter" id="quizCounter">Question 1 / 5</p>
            <div class="quiz-body" id="quizBody">
                <p class="quiz-question" id="quizQuestion"></p>
                <div class="quiz-options" id="quizOptions"></div>
            </div>
            <div class="quiz-nav">
                <button class="btn btn-secondary" id="quizPrev" disabled><i class="fas fa-arrow-left"></i> Précédent</button>
                <button class="btn btn-primary" id="quizNext">Suivant <i class="fas fa-arrow-right"></i></button>
            </div>
            <!-- Résultat -->
            <div class="quiz-result hidden" id="quizResult">
                <div class="result-circle" id="resultCircle">
                    <span id="resultScore">0%</span>
                </div>
                <h3 id="resultTitle"></h3>
                <p id="resultMessage"></p>
                <button class="btn btn-primary" id="quizRetry"><i class="fas fa-redo"></i> Recommencer</button>
            </div>
        </div>
    </div>

    <div class="modal-overlay" id="modalVideo">
        <div class="modal modal-video-player">
            <button class="modal-close" id="closeVideo"><i class="fas fa-times"></i></button>
            <div class="video-player-area">
                <div class="video-placeholder-large"><i class="fas fa-play-circle"></i><p>Lecteur vidéo — Contenu à venir</p></div>
            </div>
            <div class="video-player-info">
                <h3 id="videoPlayerTitle"></h3>
                <p id="videoPlayerDesc"></p>
                <button class="btn btn-primary btn-mark-watched" id="btnMarkWatched"><i class="fas fa-check"></i> Marquer comme vu</button>
            </div>
        </div>
    </div>
